# --- Python 运行时产物 ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- 虚拟环境 / 本地依赖 ---
.venv/
venv/
vendor/

# --- 密钥与本地配置（绝不入库）---
.env

# --- 本地数据与输出 ---
data/*.db
data/user_tokens.json
out/

# --- 工具缓存 ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- 日志 ---
*.log

# --- 操作系统垃圾文件 ---
.DS_Store
Thumbs.db
desktop.ini
