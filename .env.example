# 合同预审机器人 · 环境变量示例
# 复制为 .env 后按需填写；本文件不含任何真实凭据。

# ===== 飞书自建应用 =====
# 飞书开发者后台 → 凭证与基础信息 里的 App ID（无默认值，必填）
FEISHU_APP_ID=
# 同上处的 App Secret，属于密钥，切勿提交到仓库（无默认值，必填）
FEISHU_APP_SECRET=

# ===== 大模型（OpenAI 兼容接口）=====
# 判定模式：auto=有 Key 就调模型、mock=纯规则；默认 auto
LLM_MODE=auto
# 模型服务地址（OpenAI 兼容的 /chat/completions 根地址）；默认 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型服务 API Key；留空则自动降级为纯规则审查（无默认值）
LLM_API_KEY=
# 主模型名；默认 deepseek-chat
LLM_MODEL=deepseek-chat
# 备用模型链，逗号分隔，主模型 429/超时/输出异常时按顺序换用；默认空
LLM_FALLBACK_MODELS=
# 单份合同审查的单次调用超时（秒），合同输出较长故放宽；默认 180
LLM_TIMEOUT_REVIEW=180

# ===== 合同审查口径 =====
# 我方签约主体全称/简称，逗号分隔，用于判断我方是甲方还是乙方；默认空
OUR_COMPANIES=
# 我方所在地（城市名），逗号分隔，用于判断争议管辖地是否有利；默认空
OUR_LOCATIONS=
# 违约金占合同金额的上限（百分比），超过即报风险；默认 30
CONTRACT_PENALTY_MAX_PCT=30
# 审查报告（md/json/docx）输出目录；默认 out/contracts
CONTRACT_OUT_DIR=out/contracts
# 从飞书下载的合同附件存放目录；默认 data/uploads
CONTRACT_UPLOAD_DIR=data/uploads
# 单份合同文件大小上限（MB），超过不处理；默认 20
CONTRACT_MAX_MB=20

# ===== 机器人接入 =====
# 法务的 open_id，逗号分隔；CONTRACT_AUTO_TASK 打开后审查完给他们建任务；默认空
LAWYER_OPEN_IDS=
# 允许发合同的群 chat_id，逗号分隔（群聊里不 @ 机器人也会处理）；默认空
CONTRACT_CHAT_IDS=
# 审查完是否自动给法务建飞书任务；默认 false
CONTRACT_AUTO_TASK=false
# 自动建任务时的默认时限（天）；默认 2
CONTRACT_TASK_DUE_DAYS=2

# ===== 审批流接管 =====
# 要接管的「用印申请」审批定义 Code，逗号分隔；留空表示不接管任何审批；默认空
CONTRACT_APPROVAL_CODES=
# 审查完成后是否自动把结论回写到审批评论；默认 true
CONTRACT_COMMENT_ENABLED=true
# 是否私聊通知当前待办审批人（默认关，避免打扰）；默认 false
CONTRACT_NOTIFY_APPROVERS=false
# 审批评论用哪个用户身份署名（飞书不支持应用署名，留空则用实例发起人）；默认空
CONTRACT_COMMENT_OPEN_ID=
# 私聊预览评论时显示的审批名；默认 用印申请（合同/非合同）
CONTRACT_PREVIEW_APPROVAL_NAME=用印申请（合同/非合同）

# ===== 扫描件 OCR =====
# 扫描件 PDF 是否走本地 OCR；默认 true
CONTRACT_OCR_ENABLED=true
# 自动 OCR 的页数上限（约 10 秒/页），超过则跳过识别；默认 30
CONTRACT_OCR_MAX_PAGES=30
# OCR 渲染分辨率（DPI），越高越准也越慢；默认 150
CONTRACT_OCR_DPI=150

# ===== 存储 =====
# SQLite 数据库路径（相对项目根目录或绝对路径）；默认 data/contracts.db
DB_PATH=data/contracts.db

# ===== 用户身份授权（OAuth）=====
# OAuth 回调地址，需与飞书后台配置一致；默认 http://localhost:8787/callback
OAUTH_REDIRECT_URI=http://localhost:8787/callback
# 申请的权限范围，空格分隔；默认 task:task:write task:task:read
OAUTH_SCOPES=task:task:write task:task:read
